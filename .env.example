# คัดลอกเป็น .env แล้วใส่ค่าจริง ห้าม commit .env (spec 11.4)

# ฐานของระบบนี้ (Prisma) — เครื่องพัฒนาใช้บัญชีและฐาน *_dev
DATABASE_URL=mysql://usermanagement_dev:<password>@<host>:3306/usermanagement_dev

# ชื่อฐานไม่ต้องตั้ง: ระบบใช้ชื่อฐานท้าย DATABASE_URL และใช้ user_dev ตอนพัฒนา / user ตอนใช้งานจริง
# ตอนพัฒนาฐานต้องลงท้ายด้วย _dev ไม่งั้นแอปไม่ยอมเริ่ม (spec 11.5)
# ถ้าต้องการชื่ออื่น ตั้งเองได้: USER_DB=… APP_DB=…

# โหมดอ่านข้อมูลจริง (พัฒนาเท่านั้น): อ่านฐาน user จริงได้แต่แก้ไม่ได้ ดู sql/readonly-setup.sql
# USER_DB=user
# USER_DB_READONLY=yes

# Auth.js + Microsoft Entra ID (spec 11.3)
AUTH_SECRET=<สุ่ม 32 ไบต์: npx auth secret>
AUTH_MICROSOFT_ENTRA_ID_ID=<Client ID>
AUTH_MICROSOFT_ENTRA_ID_SECRET=<Client Secret>
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<Tenant ID>/v2.0
# production เท่านั้น: AUTH_URL=https://service.ict.up.ac.th/users/api/auth

# ใช้ในเฟส 3 (ข้อมูลอ่อนไหว)
IDCARD_HMAC_KEY=

TZ=Asia/Bangkok
